{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AMDGCN Assembly",
  "scopeName": "source.amdgcn-asm",
  "patterns": [
    { "include": "#comments" },
    { "include": "#amdgpu-metadata" },
    { "include": "#labels" },
    { "include": "#directives" },
    { "include": "#instructions" },
    { "include": "#registers" },
    { "include": "#modifiers" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.amdgcn-asm",
          "match": ";.*$"
        },
        {
          "name": "comment.line.double-slash.amdgcn-asm",
          "match": "//.*$"
        },
        {
          "name": "comment.block.amdgcn-asm",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "amdgpu-metadata": {
      "patterns": [
        {
          "name": "meta.embedded.block.amdgpu-metadata",
          "begin": "^\\s*(\\.amdgpu_metadata)\\s*$",
          "end": "^\\s*(\\.end_amdgpu_metadata)\\s*$",
          "beginCaptures": {
            "1": { "name": "keyword.control.directive.amdgcn-asm" }
          },
          "endCaptures": {
            "1": { "name": "keyword.control.directive.amdgcn-asm" }
          },
          "patterns": [
            { "include": "source.yaml" }
          ]
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^\\s*(\\.[a-zA-Z_][a-zA-Z0-9_\\.]*):",
          "captures": {
            "1": { "name": "entity.name.label.local.amdgcn-asm" }
          }
        },
        {
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*):",
          "captures": {
            "1": { "name": "entity.name.function.amdgcn-asm" }
          }
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "^\\s*(\\.(?:globl|global))\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.amdgcn-asm" },
            "2": { "name": "entity.name.function.global.amdgcn-asm" }
          }
        },
        {
          "match": "^\\s*(\\.(?:type|size))\\s+([a-zA-Z_\\.][a-zA-Z0-9_\\.]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.amdgcn-asm" },
            "2": { "name": "entity.name.symbol.amdgcn-asm" }
          }
        },
        {
          "match": "^\\s*(\\.set)\\s+([a-zA-Z_][a-zA-Z0-9_\\.]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.amdgcn-asm" },
            "2": { "name": "variable.other.constant.amdgcn-asm" }
          }
        },
        {
          "name": "keyword.control.directive.amdhsa.amdgcn-asm",
          "match": "\\.(amdhsa_[a-z_][a-z0-9_]*|end_amdhsa_kernel)\\b"
        },
        {
          "name": "keyword.control.directive.amdgcn.amdgcn-asm",
          "match": "\\.(amdgcn_target)\\b"
        },
        {
          "name": "keyword.control.directive.amdgcn-asm",
          "match": "\\.(section|text|data|bss|globl|global|local|weak|type|size|byte|short|long|quad|float|double|ascii|asciz|string|zero|fill|space|align|p2align|balign|set|equ|equiv|amd_amdgpu_isa|rodata|note|ident|addrsig|addrsig_sym|file|loc|cfi_startproc|cfi_endproc|cfi_sections|cfi_def_cfa_offset|protected|hidden|internal)\\b"
        },
        {
          "name": "support.type.amdgpu.amdgcn-asm",
          "match": "\\.(AMDGPU|amdgpu)\\.[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "constant.language.attribute.amdgcn-asm",
          "match": "@(progbits|nobits|note|function|object)"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "support.function.scalar.amdgcn-asm",
          "match": "\\bs_[a-z][a-z0-9_]*\\b"
        },
        {
          "name": "entity.name.function.vector.amdgcn-asm",
          "match": "\\bv_[a-z][a-z0-9_]*\\b"
        },
        {
          "name": "storage.type.memory.amdgcn-asm",
          "match": "\\b(flat|global|scratch|buffer|tbuffer|ds|image)_[a-z][a-z0-9_]*\\b"
        },
        {
          "name": "keyword.control.export.amdgcn-asm",
          "match": "\\bexp\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.parameter.register.scalar.amdgcn-asm",
          "match": "\\bs(\\d{1,3}|\\[\\d+:\\d+\\])\\b"
        },
        {
          "name": "variable.other.register.vector.amdgcn-asm",
          "match": "\\bv(\\d{1,3}|\\[\\d+:\\d+\\])\\b"
        },
        {
          "name": "entity.other.attribute-name.register.agpr.amdgcn-asm",
          "match": "\\ba(\\d{1,3}|\\[\\d+:\\d+\\])\\b"
        },
        {
          "name": "variable.language.register.ttmp.amdgcn-asm",
          "match": "\\bttmp(\\d{1,2}|\\[\\d+:\\d+\\])\\b"
        },
        {
          "name": "constant.language.register.special.amdgcn-asm",
          "match": "\\b(vcc|vcc_lo|vcc_hi|exec|exec_lo|exec_hi|scc|m0|null|flat_scratch|flat_scratch_lo|flat_scratch_hi|xnack_mask|xnack_mask_lo|xnack_mask_hi|tma|tma_lo|tma_hi|tba|tba_lo|tba_hi|src_vccz|src_execz|src_scc|src_lds_direct|src_pops_exiting_wave_id)\\b"
        },
        {
          "name": "constant.language.register.literal.amdgcn-asm",
          "match": "\\b(literal|off)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "keyword.operator.modifier.amdgcn-asm",
          "match": "\\b(abs|neg|clamp|omod|mul|div|op_sel|op_sel_hi|neg_lo|neg_hi|dst_sel|dst_unused|src0_sel|src1_sel|row_mask|bank_mask|bound_ctrl|fi|offset|offset0|offset1|gds|glc|slc|dlc|tfe|lwe|da|d16|a16|r128|unorm|idxen|offen|addr64|lds|done|vm|compr)\\b"
        },
        {
          "name": "storage.modifier.hwreg.amdgcn-asm",
          "match": "\\bhwreg\\s*\\([^)]+\\)"
        },
        {
          "name": "storage.modifier.sendmsg.amdgcn-asm",
          "match": "\\bsendmsg\\s*\\([^)]+\\)"
        },
        {
          "name": "storage.modifier.swizzle.amdgcn-asm",
          "match": "\\bswizzle\\s*\\([^)]+\\)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.amdgcn-asm",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.amdgcn-asm",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.amdgcn-asm",
          "match": "\\b[0-9]+\\.[0-9]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.amdgcn-asm",
          "match": "\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.amdgcn-asm",
          "match": "\\b-?[0-9]+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.amdgcn-asm",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.amdgcn-asm",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.amdgcn-asm",
          "match": "[+\\-*/&|^~!<>]|<<|>>|==|!=|<=|>="
        }
      ]
    }
  }
}
